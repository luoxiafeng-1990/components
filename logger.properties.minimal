# ============================================================
# 最小化日志配置 - WARN 级别（减少输出）
# ============================================================

# 根 Logger 设置为 WARN，只输出警告、错误和致命信息
log4cplus.rootLogger=WARN, CONSOLE

# Console Appender
log4cplus.appender.CONSOLE=log4cplus::ConsoleAppender
log4cplus.appender.CONSOLE.layout=log4cplus::PatternLayout
log4cplus.appender.CONSOLE.layout.ConversionPattern=[%D{%Y-%m-%d %H:%M:%S.%q}] [%c] [%-5p] %m%n

# 各模块级别 - 统一设置为 WARN
log4cplus.logger.components.Test=WARN
log4cplus.logger.components.MultiWorker=WARN
log4cplus.logger.components.Worker=WARN
log4cplus.logger.components.Allocator=WARN
