        </mxCell>
        
        <mxCell id="step1" value="1. setupSignalHandler()&#xa;设置 Ctrl+C 处理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
