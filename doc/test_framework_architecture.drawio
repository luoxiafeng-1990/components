        </mxCell>
        
        <mxCell id="step4" value="4. BufferConsumerService&#xa;消费帧数据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
