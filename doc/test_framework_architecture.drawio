        </mxCell>
        
        <mxCell id="step7" value="7. producer.stop()&#xa;停止生产线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
