        <mxCell id="step2" value="2. VideoProductionLine&#xa;启动解码/录制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="820" width="140" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="step3" value="3. BufferPool.get()&#xa;获取输出缓冲池" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
