        </mxCell>
        
        <mxCell id="step6" value="6. 计算统计&#xa;FPS/PSNR/SSIM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
