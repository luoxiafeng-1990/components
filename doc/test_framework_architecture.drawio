  <diagram id="test-framework-flow" name="执行流程图">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="flow-title" value="Test Framework 执行流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 用户命令 -->
        <mxCell id="start" value="用户执行命令&#xa;./qa_cases &lt;module&gt; [options]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="200" height="50" as="geometry"/>
        </mxCell>
        
        <!-- main() -->
        <mxCell id="main" value="main()&#xa;test_module_main.cpp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="160" width="200" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 注册模块 -->
        <mxCell id="register" value="registerModules()&#xa;注册所有测试套件到 Registry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="200" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 分支 - 参数解析 -->
        <mxCell id="branch1" value="argc &lt; 2?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="600" y="310" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 显示帮助 -->
        <mxCell id="help" value="printGlobalHelp()&#xa;显示所有模块列表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="320" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 获取模块 -->
        <mxCell id="getModule" value="registry.getModule(argv[1])&#xa;查找模块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="200" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 分支 - 模块是否存在 -->
        <mxCell id="branch2" value="module&#xa;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 错误 -->
        <mxCell id="error" value="Error: Unknown module&#xa;显示帮助并退出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 调用模块 run -->
        <mxCell id="moduleRun" value="module-&gt;run(argc-1, argv+1)&#xa;执行模块测试" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="200" height="40" as="geometry"/>
        </mxCell>
        
        <!-- ========================================== -->
        <!-- 模块内部执行流程 -->
        <!-- ========================================== -->
        <mxCell id="module-box" value="TestSuite 内部执行流程" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1240" height="340" as="geometry"/>
        </mxCell>
        
        <!-- parseArgs -->
