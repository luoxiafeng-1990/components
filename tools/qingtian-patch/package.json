{
	"name": "slashsubs",
	"displayName": "SlashSubs",
	"description": "%extension.description%",
	"version": "3.8.4",
	"publisher": "SlashSubs",
	"icon": "resources/icon.png",
	"license": "SEE LICENSE IN LICENSE.txt",
	"repository": {
		"type": "git",
		"url": "https://github.com/luoxiafeng-1990/slashsubs-plugin"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onView:qingtian.panel",
		"onCommand:qingtian.openPanel",
		"onCommand:qingtian.activate",
		"onCommand:qingtian.copyStartPrompt",
		"onCommand:qingtian.sendStartPrompt",
		"onCommand:qingtian.restartServer",
		"onCommand:qingtian.addChannel",
		"onCommand:qingtian.removeChannel",
		"onCommand:qingtian.enableSeamlessSwitch",
		"onCommand:qingtian.restoreWorkbench",
		"onCommand:qingtian.fullCleanup",
		"onCommand:qingtian.openWebInBrowser",
		"onCommand:qingtian.openAgentTeamWorkbench",
		"onWebviewPanel:qingtian.agentTeamWorkbench"
	],
	"extensionKind": [
		"workspace"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "qingtian.openPanel",
				"title": "%command.openPanel.title%"
			},
			{
				"command": "qingtian.activate",
				"title": "%command.activate.title%"
			},
			{
				"command": "qingtian.copyStartPrompt",
				"title": "%command.copyStartPrompt.title%"
			},
			{
				"command": "qingtian.sendStartPrompt",
				"title": "%command.sendStartPrompt.title%"
			},
			{
				"command": "qingtian.restartServer",
				"title": "%command.restartServer.title%"
			},
			{
				"command": "qingtian.addChannel",
				"title": "%command.addChannel.title%"
			},
			{
				"command": "qingtian.removeChannel",
				"title": "%command.removeChannel.title%"
			},
			{
				"command": "qingtian.enableSeamlessSwitch",
				"title": "%command.enableSeamlessSwitch.title%"
			},
			{
				"command": "qingtian.restoreWorkbench",
				"title": "%command.restoreWorkbench.title%"
			},
			{
				"command": "qingtian.fullCleanup",
				"title": "%command.fullCleanup.title%",
				"category": "%command.category.danger%"
			},
			{
				"command": "qingtian.openWebInBrowser",
				"title": "%command.openWebInBrowser.title%"
			},
			{
				"command": "qingtian.openAgentTeamWorkbench",
				"title": "%command.openAgentTeamWorkbench.title%"
			},
			{
				"command": "qingtian.resumeLoop",
				"title": "%command.resumeLoop.title%"
			},
			{
				"command": "qingtian.stopChannelTurn",
				"title": "%command.stopChannelTurn.title%"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "qingtian-container",
					"title": "%viewsContainer.title%",
					"icon": "resources/icon.svg"
				}
			]
		},
		"views": {
			"qingtian-container": [
				{
					"type": "webview",
					"id": "qingtian.panel",
					"name": "%view.panel.name%",
					"icon": "resources/icon.svg"
				}
			]
		},
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"qingtian.startPort": {
					"type": "number",
					"default": 3100,
					"minimum": 1024,
					"maximum": 65435,
					"description": "%configuration.startPort.description%"
				},
				"qingtian.autoStart": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.autoStart.description%"
				},
				"qingtian.licenseApiBase": {
					"type": "string",
					"default": "https://qingt.top/prod-api",
					"description": "%configuration.licenseApiBase.description%"
				},
				"qingtian.keepaliveEnabled": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.keepaliveEnabled.description%"
				},
				"qingtian.keepaliveMinutes": {
					"type": "number",
					"default": 45,
					"minimum": 1,
					"maximum": 120,
					"description": "%configuration.keepaliveMinutes.description%"
				},
				"qingtian.notifyOnReply": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.notifyOnReply.description%"
				},
				"qingtian.bridgeEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%configuration.bridgeEnabled.description%"
				},
				"qingtian.bridgeChannel": {
					"type": "number",
					"default": 1,
					"minimum": 1,
					"description": "%configuration.bridgeChannel.description%"
				},
				"qingtian.bridgeBotToken": {
					"type": "string",
					"default": "",
					"description": "%configuration.bridgeBotToken.description%"
				},
				"qingtian.webServerEnabled": {
					"type": "boolean",
					"default": true,
					"description": "%configuration.webServerEnabled.description%"
				},
				"qingtian.webServerPort": {
					"type": "number",
					"default": 3180,
					"minimum": 1024,
					"maximum": 65535,
					"description": "%configuration.webServerPort.description%"
				},
				"qingtian.trialDays": {
					"type": "number",
					"default": 2,
					"minimum": 1,
					"maximum": 365,
					"description": "Free trial days for new users (default 2)"
				},
				"qingtian.paidDays": {
					"type": "number",
					"default": 30,
					"minimum": 1,
					"maximum": 3650,
					"description": "确认加密货币付款后续费天数"
				},
			"qingtian.paymentAddress": {
				"type": "string",
				"default": "TBzvkRLPTeSaxJrqr2vYkVh1frnFPVD2bC",
				"description": "默认收款地址（向后兼容；推荐使用 cryptoAddresses）"
			},
			"qingtian.paymentNetwork": {
				"type": "string",
				"default": "USDT-TRC20",
				"description": "默认收款网络（向后兼容）"
			},
			"qingtian.paymentAmount": {
				"type": "string",
				"default": "9.9",
				"description": "Legacy single amount; UI now uses monthly 9.9 / yearly 49 plans"
			},
			"qingtian.paymentQrUrl": {
				"type": "string",
				"default": "",
				"description": "默认二维码 URL（向后兼容）"
			},
			"qingtian.paymentNote": {
				"type": "string",
				"default": "Choose a plan, select payment method, then Verify payment.",
				"description": "收款说明文案"
			},
			"qingtian.cryptoAddresses": {
				"type": "object",
				"default": {
					"btc": { "address": "14f9rMhcP3P55XNj8fy4GLcQuwAbrWzY5r", "network": "Bitcoin", "qrUrl": "" },
					"eth": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "Ethereum (ERC20)", "qrUrl": "" },
					"usdt-trc20": { "address": "TBzvkRLPTeSaxJrqr2vYkVh1frnFPVD2bC", "network": "USDT-TRC20 (Tron)", "qrUrl": "" },
					"usdt-erc20": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "USDT-ERC20 (Ethereum)", "qrUrl": "" },
					"usdt-arbitrum": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "USDT (Arbitrum)", "qrUrl": "" },
					"usdt-polygon": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "USDT (Polygon)", "qrUrl": "" },
					"usdt-solana": { "address": "FUjt1THuhS5pehdGxANHj2EyReAndz2dfcygFEoxg3DX", "network": "USDT (Solana)", "qrUrl": "" },
					"usdc": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "USDC (ERC20)", "qrUrl": "" },
					"usdc-arbitrum": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "USDC (Arbitrum)", "qrUrl": "" },
					"usdc-polygon": { "address": "0x65cf4353c89bd9bd43c106cd43bdb95c4d168f2b", "network": "USDC (Polygon)", "qrUrl": "" },
					"usdc-solana": { "address": "FUjt1THuhS5pehdGxANHj2EyReAndz2dfcygFEoxg3DX", "network": "USDC (Solana)", "qrUrl": "" },
					"binance-pay": { "address": "", "network": "Binance Pay", "qrUrl": "" }
				},
				"description": "多链收款地址配置。每种方式包含 address/network/qrUrl 三个字段。留空表示禁用该支付方式。",
				"markdownDescription": "多链收款地址。格式：`{ \"btc\": { \"address\": \"bc1q...\", \"network\": \"Bitcoin\", \"qrUrl\": \"\" }, ... }`"
			},
				"qingtian.renewalPassword": {
					"type": "string",
					"default": "",
					"description": "用户付款后用于续费的口令（由运营发放）"
				}
			}
		}
	},
	"scripts": {
		"obfuscate": "node scripts/obfuscate-release.mjs",
		"build:out": "tsc -p ./",
		"build:seamless": "tsc --target ES2020 --module commonjs --lib ES2020 --moduleResolution node --esModuleInterop --skipLibCheck --sourceMap true --rootDir src --outDir out src/seamlessSwitch.ts",
		"compile": "npm run build:out && npm run build:seamless && webpack --mode production && npm run obfuscate",
		"webpack": "npm run build:out && npm run build:seamless && webpack --mode production && npm run obfuscate",
		"webpack:dev": "webpack --mode development",
		"watch": "tsc -watch -p ./",
		"package": "npm run compile && npx @vscode/vsce package",
		"postinstall": "cd mcp-server && npm install"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@types/node-notifier": "^8.0.5",
		"@types/sql.js": "^1.4.11",
		"@types/vscode": "^1.85.0",
		"@types/ws": "^8.18.1",
		"javascript-obfuscator": "^5.4.1",
		"sharp": "^0.34.5",
		"ts-loader": "^9.5.4",
		"typescript": "^5.3.0",
		"webpack": "^5.104.1",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.25.1",
		"node-notifier": "^10.0.1",
		"sql.js": "^1.14.1",
		"ws": "^8.20.0"
	},
	"homepage": "https://github.com/luoxiafeng-1990/slashsubs-plugin",
	"__metadata": {
		"installedTimestamp": 1785132840311,
		"targetPlatform": "undefined",
		"size": 58433590
	}
}
