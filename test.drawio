                    <mxGeometry x="250" y="80" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="loop-start" value="主循环开始&#10;while (is_running)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="240" y="160" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="step-count-active" value="步骤1：统计活跃消费者&#10;遍历所有 Connector 和 Consumer&#10;检查 worker-&gt;isOpen()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="230" y="270" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="check-active" value="active_consumers &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="250" y="360" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step-sleep" value="休眠 100ms&#10;continue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="520" y="360" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step-create-latch" value="步骤2：创建同步门闩&#10;latch = CountDownLatch(active_consumers)&#10;success_count = 0, error_count = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="210" y="460" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step-submit-tasks" value="步骤3：提交任务到线程池&#10;遍历所有活跃消费者&#10;thread_pool.detach_task(...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
