                <mxCell id="arrow-check-to-latch" value="是" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;fontColor=#000000;" parent="1" source="check-active" target="step-create-latch" edge="1">
