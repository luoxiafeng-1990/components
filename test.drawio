                    <mxGeometry x="600" y="270" width="420" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="task-check-pool" value="检查 BufferPool 是否可用&#10;pool = buffer_pool_weak.lock()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#000000;" parent="1" vertex="1">
