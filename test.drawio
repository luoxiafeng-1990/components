                <mxCell id="task-release-buffer" value="releaseFree(buffer)&#10;break" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontColor=#000000;" parent="1" vertex="1">
