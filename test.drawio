                <mxCell id="arrow-acquire-to-check" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366" parent="1" source="task-acquire-buffer" target="task-check-buffer" edge="1">
