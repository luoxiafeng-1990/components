                    <mxGeometry x="685" y="310" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sub-return-eagain" value="return AVERROR(EAGAIN)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="880" y="310" width="130" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sub-copy-packet" value="复制 packet 数据&#10;src_packet = current_buffer_-&gt;getAVPacket()&#10;copyPacket(packet, src_packet)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="640" y="400" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="sub-decrement" value="标记完成（原子操作）&#10;remaining = remaining_subscribers_&#10;              .fetch_sub(1) - 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="640" y="510" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sub-check-last" value="是最后一个?&#10;remaining == 0" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="680" y="610" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sub-notify-fetch" value="cv_fetch_.notify_one()&#10;（唤醒 Fetch 任务）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="665" y="710" width="190" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sub-return" value="return ret&#10;（返回复制结果）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="680" y="800" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sub-not-last" value="直接返回&#10;（不通知 Fetch）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="900" y="625" width="100" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="note-sync" value="⭐ 同步机制（生产者-消费者模式）：&#10;&#10;1. Fetch 任务等待：cv_fetch_.wait (条件: remaining_subscribers_ == 0)&#10;   → 表示所有订阅者已完成当前 Buffer 的读取&#10;&#10;2. 订阅者等待：cv_subscribers_.wait (条件: current_buffer_ != nullptr)&#10;   → 表示 Fetch 任务已准备好新的 Buffer&#10;&#10;3. 计数器：remaining_subscribers_ 从 total_subscribers_ 递减到 0&#10;   → 最后一个订阅者唤醒 Fetch 任务&#10;&#10;4. 双 Buffer 机制：current_buffer_ + previous_buffer_&#10;   → 避免过早释放正在使用的 Buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontStyle=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1930" width="550" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="note-lifecycle" value="⭐ Buffer 生命周期：&#10;&#10;阶段 1：Fetch 任务获取新 Buffer (acquireFilled)&#10;  ↓&#10;阶段 2：设置为 current_buffer_，通知所有订阅者&#10;  ↓&#10;阶段 3：所有订阅者并发读取 current_buffer_&#10;  ↓&#10;阶段 4：最后一个订阅者通知 Fetch 任务&#10;  ↓&#10;阶段 5：Fetch 任务将 current_buffer_ → previous_buffer_&#10;  ↓&#10;阶段 6：下一轮循环开始时释放 previous_buffer_&#10;&#10;✅ 确保 Buffer 只在所有订阅者读取完成后才释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1930" width="380" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="note-zero-copy" value="⭐ 零拷贝设计：&#10;&#10;• 订阅者不会真正拷贝 Buffer 的数据&#10;• copyPacket() 只是让 dst_packet 指向 src_packet&#10;  dst_packet-&gt;data = src_packet-&gt;data&#10;  dst_packet-&gt;buf = nullptr (无引用计数)&#10;&#10;• avcodec_send_packet() 会在内部拷贝数据&#10;• Buffer 的生命周期由 Fetch 任务统一管理&#10;&#10;✅ 多个订阅者共享同一个 Buffer，零拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1070" y="1930" width="380" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="note-example" value="⭐ 执行示例（3 个订阅者）：&#10;&#10;时刻 T1：Fetch 获取 Buffer A，设置 current_buffer_ = A&#10;           remaining_subscribers_ = 3，唤醒所有订阅者&#10;&#10;时刻 T2：订阅者 1 读取 A，remaining_subscribers_ = 2&#10;           订阅者 2 读取 A，remaining_subscribers_ = 1&#10;           订阅者 3 读取 A，remaining_subscribers_ = 0 → 唤醒 Fetch&#10;&#10;时刻 T3：Fetch 收到通知，释放 previous_buffer_（如果有）&#10;           获取新 Buffer B&#10;&#10;时刻 T4：Fetch 设置：&#10;           previous_buffer_ = current_buffer_ (= A)&#10;           current_buffer_ = B&#10;           remaining_subscribers_ = 3&#10;&#10;时刻 T5：下一轮循环开始，释放 previous_buffer_ (A)&#10;           此时所有订阅者已完成 A 的读取 ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="2260" width="550" height="280" as="geometry"/>
                </mxCell>
