                </mxCell>
                <mxCell id="sf2" style="endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#2e7d32;" parent="1" source="w2_fill" target="pfs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sf3" style="endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#2e7d32;" parent="1" source="wn_fill" target="pfs" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sf4" style="endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#e65100;" parent="1" source="pfs" target="barrier" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sf5" style="endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#c62828;" parent="1" source="barrier" target="commit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sf6" style="endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#3f51b5;" parent="1" source="commit" target="submit_or_release" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="action_note" value="&lt;b&gt;FillResult → ConsumerAction 映射&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font size=&quot;2&quot;&gt;&lt;b&gt;kSubmit&lt;/b&gt;: 解码成功 → sync → submitFilled&lt;br&gt;&lt;b&gt;kSkip&lt;/b&gt;: 非视频/已处理 → releaseFree + sync&lt;br&gt;&lt;b&gt;kRetry&lt;/b&gt;: Again/Timeout/CodecEagain → releaseFree + sync&lt;br&gt;&lt;b&gt;kTerminate&lt;/b&gt;: EOF/Fatal → releaseFree + sync → 退出判断&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="710" width="370" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="exit_note" value="&lt;b&gt;Worker 退出条件&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font size=&quot;2&quot;&gt;1. group-&gt;is_running = false (stop)&lt;br&gt;2. running_ = false (全局停止)&lt;br&gt;3. is_active = false (熔断)&lt;br&gt;4. isEoFlush() || isAtEnd() (数据到头)&lt;br&gt;5. consecutive_failures ≥ 100 (FATAL)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="710" width="300" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
