                <mxCell id="s3" value="&lt;b&gt;validateConfig()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• Group 非空&lt;br&gt;• Producer / Consumer / Connector 非空&lt;br&gt;• 连接器名称合法&lt;br&gt;• Mode 规则 (1:1/1:N/N:1/N:M)&lt;br&gt;• 无未连接节点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="250" y="265" width="260" height="100" as="geometry"/>
