                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="conn_note" value="&lt;b&gt;Connector (ONE_TO_MANY)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;路由：1 个 Producer → N 个 Consumer&lt;br&gt;getProducerNameForConsumer()&lt;br&gt;getSharedSource(producer_name)&lt;br&gt;containsConsumer()&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
