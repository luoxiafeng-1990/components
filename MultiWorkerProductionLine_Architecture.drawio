                </mxCell>
                <mxCell id="pfs" value="&lt;b&gt;performFrameSync()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;1. 查找 owner Connector&lt;br&gt;2. 查找 coordinator&lt;br&gt;3. 获取 frame_version&lt;br&gt;4. arrive(name, ver, buf, result)&lt;/font&gt;" style="rounded=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="310" y="510" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="barrier" value="&lt;b&gt;WorkerSyncCoordinator&lt;/b&gt;&lt;br&gt;&lt;b&gt;arrive() 屏障&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;等待所有 Consumer 到齐&lt;br&gt;统计 SUCCESS/EAGAIN/ERROR&lt;br&gt;到齐后执行 callback_chain&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;strokeWidth=2;size=30;" parent="1" vertex="1">
                    <mxGeometry x="620" y="500" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="commit" value="&lt;b&gt;commitEncodedPacket()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;所有 Worker 一起 commit&lt;br&gt;确保 fetchTask 不提前唤醒&lt;/font&gt;" style="rounded=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=11;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="940" y="515" width="210" height="60" as="geometry"/>
                </mxCell>
