                <mxCell id="s2" value="initializeGlobalThreadPool&lt;br&gt;(config_.thread_pool_size)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="200" width="200" height="45" as="geometry"/>
