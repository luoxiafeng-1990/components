                    <mxGeometry x="200" y="450" width="350" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="s4a" value="new WorkerGroupRuntime&lt;br&gt;registerGroup() + linkGroupToLine()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="70" y="485" width="240" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s4b" value="&lt;b&gt;createProducersForGroup()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• new VideoProductionLine&lt;br&gt;• producer_line-&gt;start(pcfg.worker_config)&lt;br&gt;• getWorkingBufferPoolId()&lt;br&gt;• linkProducerLineToGroup()&lt;br&gt;• 保存 ProducerInfo (name/line/pool)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="540" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s4c" value="&lt;b&gt;createConnectorsForGroup()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• new Connector(mode, p_names, c_names)&lt;br&gt;• 计算 subscriber_count (按 mode)&lt;br&gt;• new EncodedPacketSourceFromBuffer&lt;br&gt;• setSourceBufferPool()&lt;br&gt;• connector-&gt;setSharedSource()&lt;br&gt;• 若 enable_frame_sync: new WSC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="340" y="485" width="240" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="s4d" value="&lt;b&gt;createConsumersForGroup()&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;• 配置 buffer_mode = true&lt;br&gt;• getConnectorForConsumer()&lt;br&gt;• 若 frame_sync: deferred_commit=true&lt;br&gt;• getProducerNameForConsumer()&lt;br&gt;• getSharedSource() 或 codec_params&lt;br&gt;• BufferFillingWorkerFactory::create()&lt;br&gt;• worker-&gt;open()&lt;br&gt;• 保存 ConsumerInfo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="340" y="605" width="240" height="120" as="geometry"/>
                </mxCell>
