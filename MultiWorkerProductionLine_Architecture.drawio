                </mxCell>
                <mxCell id="sync_t" value="帧同步模式 (enable_frame_sync = true)" style="text;html=1;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#6d0000;" parent="1" vertex="1">
