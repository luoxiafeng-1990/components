                    <mxGeometry x="1270" y="340" width="260" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p5" value="&lt;b&gt;5. 同步屏障 (Barrier)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;WorkerSyncCoordinator: arrive + callback&lt;br&gt;所有 Worker 到齐后联合 commit&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff;strokeColor=#c62828;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="410" width="260" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="p6" value="&lt;b&gt;6. 熔断机制 (Circuit Breaker)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;consecutive_failures ≥ 100 → is_active=false&lt;br&gt;Worker 自动退出，不影响其他 Worker&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff;strokeColor=#c62828;fontSize=10;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="480" width="260" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
